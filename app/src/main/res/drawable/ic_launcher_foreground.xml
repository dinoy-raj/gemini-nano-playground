<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="768"
    android:viewportHeight="768">
  <!-- 512x512 icon artwork centred in the 108dp adaptive canvas (visible 72dp = 512 units) -->
  <group
      android:translateX="128"
      android:translateY="128">
    <!-- phone -->
    <path android:pathData="M187,122H281A48,48 0,0 1,329 170V369A48,48 0,0 1,281 417H187A48,48 0,0 1,139 369V170A48,48 0,0 1,187 122Z">
      <aapt:attr name="android:fillColor">
        <gradient
            android:type="linear"
            android:startX="139"
            android:startY="122"
            android:endX="339"
            android:endY="417"
            android:startColor="#FFC6D2FF"
            android:endColor="#FF94A8FF" />
      </aapt:attr>
    </path>
    <!-- glow behind the sparkle -->
    <path android:pathData="M187,122H281A48,48 0,0 1,329 170V369A48,48 0,0 1,281 417H187A48,48 0,0 1,139 369V170A48,48 0,0 1,187 122Z">
      <aapt:attr name="android:fillColor">
        <gradient
            android:type="radial"
            android:centerX="323"
            android:centerY="204"
            android:gradientRadius="120">
          <item android:offset="0" android:color="#E6F2A2E4" />
          <item android:offset="0.55" android:color="#73E9AEEA" />
          <item android:offset="1" android:color="#00E9AEEA" />
        </gradient>
      </aapt:attr>
    </path>
    <!-- home bar -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M209,365H258A10,10 0,0 1,258 385H209A10,10 0,0 1,209 365Z" />
    <!-- sparkle -->
    <path android:pathData="M323,104C328,158 369,199 423,204C369,209 328,250 323,304C318,250 277,209 223,204C277,199 318,158 323,104Z">
      <aapt:attr name="android:fillColor">
        <gradient
            android:type="linear"
            android:startX="263"
            android:startY="144"
            android:endX="383"
            android:endY="300">
          <item android:offset="0" android:color="#FF5872FF" />
          <item android:offset="0.55" android:color="#FF6E63FD" />
          <item android:offset="1" android:color="#FFA65FE6" />
        </gradient>
      </aapt:attr>
    </path>
  </group>
</vector>
