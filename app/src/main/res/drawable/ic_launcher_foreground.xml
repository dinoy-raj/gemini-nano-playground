<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- device -->
    <path android:pathData="M42,31H56A9,9 0,0 1,65 40V72A9,9 0,0 1,56 81H42A9,9 0,0 1,33 72V40A9,9 0,0 1,42 31Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="34"
                android:startY="34"
                android:endX="66"
                android:endY="82"
                android:startColor="#FFC4D2FF"
                android:endColor="#FF93A6FF" />
        </aapt:attr>
    </path>

    <!-- glow where the spark lands on the device -->
    <path android:pathData="M42,31H56A9,9 0,0 1,65 40V72A9,9 0,0 1,56 81H42A9,9 0,0 1,33 72V40A9,9 0,0 1,42 31Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="62"
                android:centerY="46"
                android:gradientRadius="14"
                android:startColor="#F2FFB8DF"
                android:endColor="#00FFB8DF" />
        </aapt:attr>
    </path>

    <!-- home bar -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M44.75,72H53.25A1.75,1.75 0,0 1,53.25 75.5H44.75A1.75,1.75 0,0 1,44.75 72Z" />

    <!-- spark -->
    <path android:pathData="M64,28Q66.72,42.28 81,45Q66.72,47.72 64,62Q61.28,47.72 47,45Q61.28,42.28 64,28Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="52"
                android:startY="26"
                android:endX="80"
                android:endY="62">
                <item android:offset="0" android:color="#FF3E8BFF" />
                <item android:offset="0.6" android:color="#FF7A5CFF" />
                <item android:offset="1" android:color="#FFFF6FB1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
